# Backend
FLASK_APP=backend.wsgi:app
FLASK_DEBUG=0
SECRET_KEY=change-me
DATABASE_URL=sqlite:///smartroom.db
JWT_SECRET_KEY=change-me-jwt
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
DEVICE_TOKEN_EXPIRES_DAYS=365

# MQTT broker (IPv4 of this laptop for ESP32 on LAN)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TLS_PORT=8883
MQTT_BACKEND_USERNAME=backend_service
MQTT_BACKEND_PASSWORD=backend_service_password
MQTT_SIM_USERNAME=sim_device
MQTT_SIM_PASSWORD=sim_device_password
MQTT_DEVICE_USER_PREFIX=device_

# Worker
MQTT_WORKER_CLIENT_ID=smartroom-worker
MQTT_COMMAND_POLL_SECONDS=1
MQTT_COMMAND_TIMEOUT_SECONDS=10
DEVICE_OFFLINE_AFTER_SECONDS=15

# Default thresholds
DEFAULT_TEMP_HIGH_C=32.0
DEFAULT_TEMP_LOW_C=10.0
DEFAULT_HUMIDITY_HIGH=80.0
DEFAULT_HUMIDITY_LOW=20.0

# Simulator default device
SIM_DEVICE_ID=sim-esp32-001
SIM_DEVICE_NAME=Simulated ESP32 Room 1
SIM_TELEMETRY_INTERVAL_SECONDS=5
SIM_HEARTBEAT_INTERVAL_SECONDS=5
SIM_OFFLINE_AFTER_SECONDS=15
SIM_FORCE_ALERT=0
